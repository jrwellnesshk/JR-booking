<Slide style={{ background: '#F0E4D2' }}>
  <Box style={{ height: 120, paddingLeft: 64, paddingRight: 64, paddingTop: 22, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
    <Box style={{ width: 8, height: 40, background: '#7E9476', borderRadius: 4 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#3E2A1E' }}>第 5 步：上傳代碼與 .env 安全設定</Text>
  </Box>
  <Box style={{ height: 540, paddingLeft: 64, paddingRight: 64, paddingTop: 8, flexDirection: 'row', gap: 24 }}>
    <Box style={{ flex: 1.25, justifyContent: 'center' }}>
      <CodeBlock
        code={`# 方法 A：用 git（你嘅 repo）
cd ~
git clone <你嘅repo網址> app
cd app

# 方法 B：由自己 Mac / Linux 終端機 scp 上傳
# chmod 400 aurora-key.pem   # 先改鑰匙權限（只需一次）
# scp -i aurora-key.pem -r ./booking-aurora ubuntu@<Public-IP>:~/app

# 裝生產用依賴（唔裝 dev）
cd ~/app
npm install --omit=dev

# 建立生產 .env（千萬唔好 copy 本地有 CAPTCHA_TEST_BYPASS 嗰個）
cp .env.example .env
nano .env`}
        language='bash'
        width={620}
        fontSize={13}
      />
    </Box>
    <Box style={{ flex: 1, gap: 12, justifyContent: 'center' }}>
      <Box style={{ backgroundColor: '#C0392B', borderRadius: 14, padding: '16px 18px' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#fff' }}>預警：.env 最大伏位</Text>
        <Text style={{ fontSize: 15, color: '#fff', lineHeight: 1.6, marginTop: 8 }}>絕對唔好將 CAPTCHA_TEST_BYPASS 放落生產 .env —— 等於開咗後門，任何人填 captchaAnswer=test999 就繞過驗證碼登入。</Text>
      </Box>
      <Box style={{ backgroundColor: '#FFFFFF', borderRadius: 14, padding: '16px 18px' }}>
        <Text style={{ fontSize: 16, color: '#3E2A1E', lineHeight: 1.7 }}>SESSION_SECRET 必須設定：<Text style={{ fontWeight: 'bold' }}>node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"</Text> 複製結果落 .env。同時 NODE_ENV=production、PORT=4000。</Text>
        <Text style={{ fontSize: 16, color: '#3E2A1E', lineHeight: 1.7, marginTop: 8 }}>.env 記得加落 .gitignore，唔好 commit 去 git。</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ height: 60, paddingLeft: 64, paddingRight: 64, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#7c6f63' }}>寶天醫館 · AWS 上線手把手教學</Text>
    <Text style={{ fontSize: 14, color: '#7c6f63' }}>12 / 18</Text>
  </Box>
</Slide>
