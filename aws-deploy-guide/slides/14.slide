<Slide style={{ background: '#F0E4D2' }}>
  <Box style={{ height: 120, paddingLeft: 64, paddingRight: 64, paddingTop: 22, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
    <Box style={{ width: 8, height: 40, background: '#7E9476', borderRadius: 4 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#3E2A1E' }}>第 7 步：Nginx 反向代理 + HTTPS + 網域</Text>
  </Box>
  <Box style={{ height: 540, paddingLeft: 64, paddingRight: 64, paddingTop: 8, flexDirection: 'row', gap: 24 }}>
    <Box style={{ flex: 1.2, justifyContent: 'center' }}>
      <Text style={{ fontSize: 16, color: '#3E2A1E', marginBottom: 6 }}>建立 Nginx 設定檔 <Text style={{ fontWeight: 'bold' }}>/etc/nginx/sites-available/aurora</Text>：</Text>
      <CodeBlock
        code={`server {
  listen 80;
  server_name yourdomain.com www.yourdomain.com;
  location / {
    proxy_pass http://localhost:4000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}`}
        language='nginx'
        width={600}
        fontSize={12}
      />
    </Box>
    <Box style={{ flex: 1, gap: 10, justifyContent: 'center' }}>
      {[['生效設定','sudo ln -s /etc/nginx/sites-available/aurora /etc/nginx/sites-enabled/ ; sudo nginx -t ; sudo systemctl restart nginx'],['開防火牆','sudo ufw allow "Nginx Full" ; sudo ufw allow OpenSSH ; sudo ufw enable'],['裝 HTTPS 證書','sudo apt install -y certbot python3-certbot-nginx ; sudo certbot --nginx -d yourdomain.com -d www.yourdomain.com'],['測試續期','sudo certbot renew --dry-run'],['綁網域','DNS 加 A 記錄 → EC2 彈性 IP（先申請 Elastic IP 固定地址）']].map((s, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 12 }}>
          <Box style={{ width: 28, height: 28, borderRadius: 14, background: '#7E9476', justifyContent: 'center', alignItems: 'center' }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#fff' }}>{i + 1}</Text>
          </Box>
          <Text style={{ fontSize: 15, color: '#3E2A1E', flex: 1 }}><Text style={{ fontWeight: 'bold' }}>{s[0]}：</Text> {s[1]}</Text>
        </Box>
      ))}
    </Box>
  </Box>
  <Box style={{ height: 60, paddingLeft: 64, paddingRight: 64, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#7c6f63' }}>寶天醫館 · AWS 上線手把手教學</Text>
    <Text style={{ fontSize: 14, color: '#7c6f63' }}>14 / 18</Text>
  </Box>
</Slide>
