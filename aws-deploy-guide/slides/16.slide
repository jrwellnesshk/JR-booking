<Slide style={{ background: '#F0E4D2' }}>
  <Box style={{ height: 120, paddingLeft: 64, paddingRight: 64, paddingTop: 22, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
    <Box style={{ width: 8, height: 40, background: '#7E9476', borderRadius: 4 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#3E2A1E' }}>上線前檢查清單（Go-Live Checklist）</Text>
  </Box>
  <Box style={{ height: 540, paddingLeft: 64, paddingRight: 64, paddingTop: 12, flexDirection: 'row', gap: 30 }}>
    <Box style={{ flex: 1, gap: 14, justifyContent: 'center' }}>
      {['刪走 .env 入面嘅 CAPTCHA_TEST_BYPASS（後門）','改晒弱密碼（admin 12345678、staff01、cheuk951211、8udc）','WhatsApp 轉正式通道（Twilio sandbox → 正式號碼）','Stripe 設定好，或決定暫時唔開放付款升級'].map((t, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Box style={{ width: 24, height: 24, borderRadius: 6, border: '2px solid #7E9476', backgroundColor: '#FFFFFF' }} />
          <Text style={{ fontSize: 17, color: '#3E2A1E', flex: 1 }}>{t}</Text>
        </Box>
      ))}
    </Box>
    <Box style={{ flex: 1, gap: 14, justifyContent: 'center' }}>
      {['NODE_ENV=production、ALLOWED_ORIGINS、SITE_URL 設好','pm2 常駐 + pm2 startup 開機自啟','HTTPS 綠色鎖生效（網址前面把鎖）','備份排程有實際跑（S3 有今日檔）'].map((t, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Box style={{ width: 24, height: 24, borderRadius: 6, border: '2px solid #7E9476', backgroundColor: '#FFFFFF' }} />
          <Text style={{ fontSize: 17, color: '#3E2A1E', flex: 1 }}>{t}</Text>
        </Box>
      ))}
    </Box>
  </Box>
  <Box style={{ height: 60, paddingLeft: 64, paddingRight: 64, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#7c6f63' }}>寶天醫館 · AWS 上線手把手教學</Text>
    <Text style={{ fontSize: 14, color: '#7c6f63' }}>16 / 18</Text>
  </Box>
</Slide>
