<Slide style={{ background: '#F0E4D2' }}>
  <Box style={{ height: 120, paddingLeft: 64, paddingRight: 64, paddingTop: 22, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
    <Box style={{ width: 8, height: 40, background: '#7E9476', borderRadius: 4 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#3E2A1E' }}>第 1 步：開 AWS 帳號與設定付款</Text>
  </Box>
  <Box style={{ height: 540, paddingLeft: 64, paddingRight: 64, paddingTop: 10, flexDirection: 'column', gap: 12, justifyContent: 'center' }}>
    {[['去 aws.amazon.com，撳右上角「Create an AWS Account」（免費）'],['填 email、密碼，帳號名稱填你診所名（例如 AuroraClinic）'],['填聯絡資料：國家揀 Hong Kong，地址填得'],['填信用卡：會有 $1 授權驗證，幾日內退返，唔會扣錢'],['電話驗證：揀香港 +852，收 SMS 或來電入號碼'],['揀 Support plan：Basic（免費）就夠，撳「Complete sign-up」'],['登入 AWS Management Console，用返個 root 帳號 email 同密碼']].map((s, i) => (
      <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Box style={{ width: 30, height: 30, borderRadius: 15, background: '#7E9476', justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#fff' }}>{i + 1}</Text>
        </Box>
        <Text style={{ fontSize: 19, color: '#3E2A1E' }}>{s[0]}</Text>
      </Box>
    ))}
  </Box>
  <Box style={{ height: 60, paddingLeft: 64, paddingRight: 64, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#7c6f63' }}>寶天醫館 · AWS 上線手把手教學</Text>
    <Text style={{ fontSize: 14, color: '#7c6f63' }}>07 / 18</Text>
  </Box>
</Slide>
