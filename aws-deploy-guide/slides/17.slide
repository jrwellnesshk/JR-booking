<Slide style={{ background: '#F0E4D2' }}>
  <Box style={{ height: 120, paddingLeft: 64, paddingRight: 64, paddingTop: 22, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
    <Box style={{ width: 8, height: 40, background: '#7E9476', borderRadius: 4 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#3E2A1E' }}>常見問題救火與日常維運指令</Text>
  </Box>
  <Box style={{ height: 540, paddingLeft: 64, paddingRight: 64, paddingTop: 8, flexDirection: 'row', gap: 24 }}>
    <Box style={{ flex: 1.15, gap: 12, justifyContent: 'center' }}>
      {[['網站打唔開','檢查 EC2 係 running、安全組開咗 80/443、nginx 同 pm2 有冇起'],['見到 502 Bad Gateway','App 冇起：pm2 restart potin-clinic，再 pm2 logs 睇錯誤'],['HTTPS 變紅色鎖','證書過期？sudo certbot renew 續期'],['改咗 code 冇反應','pm2 restart potin-clinic 重啟就掂'],['磁碟爆滿','df -h 睇，清走舊 logs']].map((q, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 12 }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#5D4037', width: 150 }}>{q[0]}：</Text>
          <Text style={{ fontSize: 16, color: '#3E2A1E', flex: 1, lineHeight: 1.5 }}>{q[1]}</Text>
        </Box>
      ))}
    </Box>
    <Box style={{ flex: 1, justifyContent: 'center' }}>
      <Text style={{ fontSize: 16, color: '#3E2A1E', marginBottom: 6 }}>維運指令 cheat sheet：</Text>
      <CodeBlock
        code={`pm2 status
pm2 logs potin-clinic
pm2 restart potin-clinic

sudo systemctl status nginx
sudo tail -n 50 ~/app/logs/app-$(date +%F).log`}
        language='bash'
        width={640}
        fontSize={14}
      />
    </Box>
  </Box>
  <Box style={{ height: 60, paddingLeft: 64, paddingRight: 64, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#7c6f63' }}>寶天醫館 · AWS 上線手把手教學</Text>
    <Text style={{ fontSize: 14, color: '#7c6f63' }}>17 / 18</Text>
  </Box>
</Slide>
