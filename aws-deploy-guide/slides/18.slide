      <Box style={{ width: '48%', backgroundColor: 'rgba(255,255,255,0.12)', borderRadius: 14, padding: '16px 20px' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#F0E4D2' }}>資料</Text>
        <Text style={{ fontSize: 16, color: '#F0E4D2', lineHeight: 1.6, marginTop: 6 }}>每日自動備份 SQLite 去 S3；千萬唔好靠單一 EBS 硬碟。</Text>
