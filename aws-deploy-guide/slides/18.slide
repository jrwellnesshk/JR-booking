    <Box style={{ flexDirection: 'row', gap: 18, marginTop: 28, flexWrap: 'wrap' }}>
      <Box style={{ width: '48%', backgroundColor: 'rgba(255,255,255,0.12)', borderRadius: 14, padding: '16px 20px' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#F0E4D2' }}>費用</Text>
        <Text style={{ fontSize: 16, color: '#F0E4D2', lineHeight: 1.6, marginTop: 6 }}>免費層得 12 個月，到期前設 Billing Alarm；彈性 IP 唔好閒置。</Text>
