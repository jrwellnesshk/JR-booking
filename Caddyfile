{
    # SSL 由 CloudFront 做（AWS ACM 證書），EC2 只跑純 HTTP
    # 唔設 email / acme_dns：唔需要 Let's Encrypt，避免開 80/443 俾 ACME 挑戰
}

:80 {
    encode gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
        # HSTS 由 CloudFront 嘅 Response Headers Policy 加（瀏覽器只會喺 HTTPS 尊重 HSTS）
    }
    # 上載大頭像等，放寬 body 大小
    request_body {
        max_size 20MB
    }
    reverse_proxy app:4000
}
