# ============================================================
# 寶天醫館預約系統 - 環境變數範本
# 複製做 .env 並填寫。生產環境切勿設定 CAPTCHA_TEST_BYPASS。
# ============================================================

# ---- 必須 (Required) ----
# 用嚟簽署 JWT 同 session cookie。生產環境必須設定（唔設會拒絕啟動）。
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# 運行模式：production / development / test
NODE_ENV=production

# 對外端口（容器內）
PORT=4000

# ---- 對外域名（生產設真實域名；Staging 用 localhost）----
# SITE_DOMAIN 用於 preflight 檢查；SITE_URL / PUBLIC_BASE_URL 用於 Stripe / 優惠券回呼；ALLOWED_ORIGINS 用於 CORS 白名單。
SITE_DOMAIN=www.jrwellnesshk.com
SITE_URL=https://www.jrwellnesshk.com
PUBLIC_BASE_URL=https://www.jrwellnesshk.com
ALLOWED_ORIGINS=https://www.jrwellnesshk.com

# ---- 初始管理員密碼（可選）----
# 首次建庫時，若無 admin 帳戶會用呢個密碼建立 admin。
# 唔設嘅話會隨機生成並印到容器 log（請盡快登入修改）。
# ADMIN_PASSWORD=

# ---- 資料庫 ----
# 預設：檔案型 SQLite（容器內路徑配合 docker-compose 嘅 ./data volume）
DB_PATH=/app/data/database.db

# ===== Amazon RDS PostgreSQL（部署用）=====
# 只要 DATABASE_URL 係 postgres:// 開頭，config/db.js 會自動切去 RDS PostgreSQL，
# route / service 代碼全部唔使改（config/db-pg.js 提供 sqlite3 風格適配層）。
# 填法 A：成條連接字串（推薦）
#   DATABASE_URL=postgres://<username>:<password>@<rds-endpoint>:5432/<dbname>?sslmode=require
# 填法 B：分項（冇 DATABASE_URL 時生效）
#   PGHOST=<rds-endpoint>
#   PGPORT=5432
#   PGUSER=<master-username>
#   PGPASSWORD=<master-password>
#   PGDATABASE=<dbname>
#   PGSSL=false   # 預設 SSL（rejectUnauthorized:false）；如要嚴格驗證證書設 PGSSL_CA
#
# 首次部署：先于 RDS 執行 config/schema.pg.sql 建立全表
#   psql "$DATABASE_URL" -f config/schema.pg.sql
# （app 啟動都會自動 CREATE TABLE IF NOT EXISTS，但手動跑一次確保一次過建好）
# 現有 SQLite 數據用 pg_dump / 遷移工具搬到 RDS，唔好直接 copy 檔。


# ---- 驗證碼 ----
# ⚠️ 生產環境必須刪除下面呢行！否則 captchaAnswer=test999 會成為後門繞過驗證碼。
# CAPTCHA_TEST_BYPASS=test999

# ---- Email (nodemailer / Gmail) ----
EMAIL_USER=your-clinic@gmail.com
EMAIL_PASS=16位數-gmail-app-password

# ---- WhatsApp (Twilio) ----
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_NUMBER=whatsapp:+85200000000

# ---- Stripe 付款（可選；唔設則付款功能停用）----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_ANNUAL=

# ---- Cloudflare（可選；Caddy DNS-01 挑戰用，唔使開 80 port）----
# CLOUDFLARE_API_TOKEN=
# SITE_DOMAIN=booking.yourdomain.com
