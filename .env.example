# ============================================================
# 寶天醫館預約系統 - 環境變數範本
# 複製做 .env 並填寫。生產環境切勿設定 CAPTCHA_TEST_BYPASS。
# ============================================================

# ---- 必須 (Required) ----
# 用嚟簽署 JWT 同 session cookie。生產環境必須設定（唔設會拒絕啟動）。
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# 運行模式：production / development / test
NODE_ENV=production

# 對外端口（容器內）
PORT=4000

# ---- 初始管理員密碼（可選）----
# 首次建庫時，若無 admin 帳戶會用呢個密碼建立 admin。
# 唔設嘅話會隨機生成並印到容器 log（請盡快登入修改）。
# ADMIN_PASSWORD=

# ---- 資料庫 ----
# 現時用檔案型 SQLite。容器內路徑配合 docker-compose 嘅 ./data volume：
DB_PATH=/app/data/database.db
# 未來轉 PostgreSQL 時設 DATABASE_URL 並移除 ./data volume（見 README-DEPLOY.md）
# DATABASE_URL=postgresql://aurora:PASSWORD@db:5432/aurora

# ---- 驗證碼 ----
# ⚠️ 生產環境必須刪除下面呢行！否則 captchaAnswer=test999 會成為後門繞過驗證碼。
# CAPTCHA_TEST_BYPASS=test999

# ---- Email (nodemailer / Gmail) ----
EMAIL_USER=your-clinic@gmail.com
EMAIL_PASS=16位數-gmail-app-password

# ---- WhatsApp (Twilio) ----
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_NUMBER=whatsapp:+85200000000

# ---- Stripe 付款（可選；唔設則付款功能停用）----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_ANNUAL=

# ---- Cloudflare（可選；Caddy DNS-01 挑戰用，唔使開 80 port）----
# CLOUDFLARE_API_TOKEN=
# SITE_DOMAIN=booking.yourdomain.com
